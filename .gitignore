# secrets & local runtime — never commit
.env
state/
venv/
__pycache__/
.code-review-graph/
*.pyc
*.bak
*.bak_*
*~
*.orig

# private, workspace-specific commands (keep your real ones out of the repo)
loki/platforms/slack/private_commands.py

# local account-login helpers — they name a config dir on this machine, and
# whoever runs one decides which account it logs in. Not shared setup.
login-*-account.ps1

# workspace-private material — company docs, Slack app manifests, ops tooling.
# never publish: contains internal names and app identifiers.
private/

# your own plugins — yours, and they survive pulling upstream updates.
# *.py.example is tracked so the shipped example still ships.
plugins/*.py
!plugins/*.py.example
