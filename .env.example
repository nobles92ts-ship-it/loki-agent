# ── Which chat platform to serve ────────────────────────────────────────────
# slack (default) | discord. One process = one platform; run two processes to
# serve both (they share state/ safely). Also settable per run:
#   python -m loki discord
LOKI_PLATFORM=slack

# ── Slack app (create it from loki/platforms/slack/manifest.yaml) ──────────
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# Your Slack member ID (Profile → ⋯ → Copy member ID).
# Fail-closed: Loki refuses to boot without it. Only this user may DM / write.
ALLOWED_USER_ID=U00000000

# ── Discord app (only when LOKI_PLATFORM=discord) — see docs/SETUP.md ───────
# Bot token from https://discord.com/developers/applications → Bot → Reset Token.
# The MESSAGE CONTENT intent must be ON there or the bot cannot read messages.
#DISCORD_BOT_TOKEN=your-discord-bot-token
# Your Discord user ID (Settings → Advanced → Developer Mode, then right-click
# your name → Copy User ID). Fail-closed, same as Slack's ALLOWED_USER_ID.
#DISCORD_OWNER_ID=000000000000000000

# ── Telegram (only when LOKI_PLATFORM=telegram) ─────────────────────────────
# Token from @BotFather, and YOUR numeric user id (ask @userinfobot).
# Same fail-closed rule: that one id owns the private chat and write power.
#TELEGRAM_BOT_TOKEN=123456:AA...
#TELEGRAM_OWNER_ID=000000000

# ── What Loki may touch ─────────────────────────────────────────────────────
# The directory Claude works in (project root for reads/writes/commands).
WORK_DIR=C:\Users\YourName\Documents

# plan            = read-only (SAFE DEFAULT — analysis, summaries, lookups)
# bypassPermissions = FULL write/execute on this PC via Slack messages.
#                     Opt in only on a machine you fully control. Guests are
#                     always forced to plan regardless of this setting.
CLAUDE_PERMISSION_MODE=plan

# Guest throttle: max requests per rolling hour per non-owner (protects your
# subscription limits). 0 = unlimited. Owners are never throttled.
GUEST_RATE_PER_HOUR=10

# ── Dedicated account (optional) ─────────────────────────────────────────────
# Point the spawned `claude` at its OWN config dir so it logs in as a specific
# account, independent of your terminal login (great for separating work vs
# personal). Log into it once:  CLAUDE_CONFIG_DIR=<dir> claude  → /login
# Empty/absent = use the default (~/.claude) account. Windows/Linux only.
#CLAUDE_CONFIG_DIR=C:\Users\YourName\.claude-loki

# ── Account pin (optional) ───────────────────────────────────────────────────
# Stronger than the config dir above: a subscription OAuth token outranks the
# stored login, so EVERY spawn runs as this account even when your terminal is
# logged into a different one — including paths that must keep the default
# ~/.claude (pipelines that read ~/.claude/skills and agents at run time).
# Get it with `claude setup-token` in a REAL terminal window (it needs a TTY):
# approve in the browser, paste the code the browser shows BACK into the
# terminal, and the terminal then prints the token. The token starts with
# `sk-ant-oat01-`; the browser's code is NOT the token. Expires after 1 year.
# WARNING: if this token is invalid or expired, `claude` does NOT fail — it
# silently falls back to the stored login. Verify per docs/SETUP.md.
# With two accounts to pick between, `!account off` / `!account on` switches
# the pin from chat without touching this line or restarting the worker.
#CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-xxxxxxxx

# ── Conversation memory ─────────────────────────────────────────────────────
# A DM (or a thread) keeps its Claude session, so follow-up messages continue
# instead of starting over. It resets after this many minutes of silence —
# longer means better continuity but a heavier context, and cost, every turn.
# 0 = never expire. `!new` resets one conversation on demand regardless.
SESSION_IDLE_MIN=120

# ── Optional ────────────────────────────────────────────────────────────────
#CLAUDE_MODEL=sonnet          # lighter on your subscription limits (default: account default)
#TIMEOUT_SEC=300              # per-request timeout (seconds)
#JOB_CONCURRENCY=2            # parallel Claude jobs (same conversation stays ordered)
#LOKI_LANG=en                 # bot message language: en | ko
#LOKI_CHANNEL_CTX_DAYS=7      # channel history window for bare channel mentions
#LOKI_CHANNEL_CTX_MSGS=120    # max messages in that window
#CLAUDE_CMD=                  # auto-detected from PATH; set the full path if needed
#SELFTEST_ON_BOOT=1           # verify read-only guarantee at boot (plan mode only)

# ── Private commands (optional) ──────────────────────────────────────────────
# If you copy private_commands.example.py → private_commands.py (gitignored),
# set the trusted-user allowlist(s) it reads here, e.g.:
#REPORT_USERS=U01234567,U07654321   # named users allowed to run your !command

# Per-file cap for attachments in and !send out (MB).
#LOKI_MAX_FILE_MB=20
