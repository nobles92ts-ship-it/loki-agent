# ── Which chat platform to serve ────────────────────────────────────────────
# slack (default) | discord. One process = one platform; run two processes to
# serve both (they share state/ safely). Also settable per run:
#   python -m loki discord
LOKI_PLATFORM=slack

# ── Slack app (create it from loki/platforms/slack/manifest.yaml) ──────────
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# Your Slack member ID (Profile → ⋯ → Copy member ID).
# Fail-closed: Loki refuses to boot without it. Only this user may DM / write.
ALLOWED_USER_ID=U00000000

# ── Discord app (only when LOKI_PLATFORM=discord) — see docs/SETUP.md ───────
# Bot token from https://discord.com/developers/applications → Bot → Reset Token.
# The MESSAGE CONTENT intent must be ON there or the bot cannot read messages.
#DISCORD_BOT_TOKEN=your-discord-bot-token
# Your Discord user ID (Settings → Advanced → Developer Mode, then right-click
# your name → Copy User ID). Fail-closed, same as Slack's ALLOWED_USER_ID.
#DISCORD_OWNER_ID=000000000000000000

# ── Telegram (only when LOKI_PLATFORM=telegram) ─────────────────────────────
# Token from @BotFather, and YOUR numeric user id (ask @userinfobot).
# Same fail-closed rule: that one id owns the private chat and write power.
#TELEGRAM_BOT_TOKEN=123456:AA...
#TELEGRAM_OWNER_ID=000000000
#TELEGRAM_POLL_TIMEOUT=50     # long-poll seconds (default 50)

# ── What Loki may touch ─────────────────────────────────────────────────────
# The directory Claude works in (project root for reads/writes/commands).
WORK_DIR=C:\Users\YourName\Documents

# plan            = read-only (SAFE DEFAULT — analysis, summaries, lookups)
# bypassPermissions = FULL write/execute on this PC via Slack messages.
#                     Opt in only on a machine you fully control. Guests are
#                     always forced to plan regardless of this setting.
CLAUDE_PERMISSION_MODE=plan

# Your own DM.
# full       = it runs at CLAUDE_PERMISSION_MODE with every tool the agent has.
#              On Codex that includes a browser and computer use, which clicks
#              and types on the same mouse and keyboard you are using.
# restricted = it takes the route you get in a shared channel. With
#              LOKI_RESTRICTED_MODE=sealed on codex that is no tools at all: the
#              agent answers from what Loki hands it (the thread, screenshots,
#              the guests' shared folders). On Claude it is only the
#              permission-file guard, so the tools stay.
#LOKI_OWNER_MODE=full

# A request that needs a sandbox (guests, you in a shared channel) when the
# selected provider cannot hold one — Codex cannot carry Claude's deny rules.
# fallback = run it on Claude with the deny-rule settings file, as always.
# sealed   = run it on Codex with no tools at all; guests' shared folders are
#            read through Loki instead (docs/codex-migration.md).
#LOKI_RESTRICTED_MODE=fallback

# Guest throttle: max requests per rolling hour per non-owner (protects your
# subscription limits). 0 = unlimited. Owners are never throttled.
GUEST_RATE_PER_HOUR=10

# ── Which agent answers (optional) ───────────────────────────────────────────
# Loki spawns an agent CLI that is already logged in on this machine, so the
# bill stays on a plan you already pay for. Any of these can be that agent:
#
#   claude       Claude Code            Claude Pro/Max subscription  (default)
#   antigravity  Antigravity CLI (agy)  Google AI Pro/Ultra or free tier
#   codex        Codex CLI              ChatGPT Plus/Pro plan
#   kimi         Claude Code → Moonshot Kimi coding plan, or a metered key
#   gemini       Gemini CLI             API key / enterprise licence only
#   groq         Groq HTTP endpoint     free tier (talk only — no tools/files)
#
# `!provider <name>` switches at runtime; this is what a restart returns to.
# Conversations are remembered per provider, so switching back finds yours.
#
# ⚠️ One rule overrides the choice: requests that need a sandbox — every guest,
# and you outside your own DM — always run on Claude, because Loki's guest scope
# is a Claude Code deny-rule file that the others cannot carry. See SECURITY.md.
#LOKI_PROVIDER=claude

# antigravity — Google's successor to the Gemini CLI, and where a Google plan
#   answers now. Install:  irm https://antigravity.google/cli/install.ps1 | iex
#   (macOS/Linux: see antigravity.google/docs/cli/install). Sign-in happens on
#   first launch and lives in the OS keyring — no key, no env var.
#   ⚠️ The installer adds its folder to the PATH *registry*; a process that was
#   already running won't see it until it restarts. Loki also looks in
#   %LOCALAPPDATA%\agy\bin, so this only matters for your own shell.
#ANTIGRAVITY_MODEL=           # e.g. "Gemini 3.6 Flash (High)" — `agy models`
#ANTIGRAVITY_EFFORT=          # low | medium | high
#ANTIGRAVITY_CMD=             # only if `agy` is somewhere unusual

# gemini — ⚠️ Google stopped serving this CLI to INDIVIDUAL accounts in June
#   2026, free tier and Google AI Pro/Ultra alike. Signing in still succeeds and
#   the first request then fails. Use `antigravity` for a plan. What still works
#   here: an API key (AI Studio — free tier, metered above it) or an enterprise
#   Code Assist licence.
#GEMINI_AUTH=oauth            # oauth = enterprise licence · apikey · vertex
#GEMINI_API_KEY=              # GEMINI_AUTH=apikey
#GOOGLE_API_KEY=              # GEMINI_AUTH=vertex (with GOOGLE_GENAI_USE_VERTEXAI)
#GEMINI_MODEL=
#GEMINI_CMD=                  # only if `gemini` is not on PATH

# codex — sign in once with `codex login` (choose ChatGPT, not an API key).
#CODEX_MODEL=
#CODEX_CMD=

# kimi — Moonshot's Anthropic-compatible endpoint, driven by the claude binary.
#   A platform key bills per token; a Kimi coding plan key is flat. Same field.
#   Use api.moonshot.cn instead if your account is the China one.
#KIMI_API_KEY=
#MOONSHOT_API_KEY=            # accepted as an alias for KIMI_API_KEY
#KIMI_BASE_URL=https://api.moonshot.ai/anthropic
#KIMI_MODEL=kimi-k2.5

# groq — console.groq.com. Free tier is rate-limited rather than metered.
#   No tools: it cannot read a file or run a command, only talk.
#GROQ_API_KEY=
#GROQ_MODEL=llama-3.3-70b-versatile
#GROQ_URL=                    # override the endpoint (default: Groq's own)

# ── Dedicated account (optional) ─────────────────────────────────────────────
# Point the spawned `claude` at its OWN config dir so it logs in as a specific
# account, independent of your terminal login (great for separating work vs
# personal). Log into it once:  CLAUDE_CONFIG_DIR=<dir> claude  → /login
# Empty/absent = use the default (~/.claude) account. Windows/Linux only.
#CLAUDE_CONFIG_DIR=C:\Users\YourName\.claude-loki

# ── Account pin (optional) ───────────────────────────────────────────────────
# Stronger than the config dir above: a subscription OAuth token outranks the
# stored login, so EVERY spawn runs as this account even when your terminal is
# logged into a different one — including paths that must keep the default
# ~/.claude (pipelines that read ~/.claude/skills and agents at run time).
# Get it with `claude setup-token` in a REAL terminal window (it needs a TTY):
# approve in the browser, paste the code the browser shows BACK into the
# terminal, and the terminal then prints the token. The token starts with
# `sk-ant-oat01-`; the browser's code is NOT the token. Expires after 1 year.
# WARNING: if this token is invalid or expired, `claude` does NOT fail — it
# silently falls back to the stored login. Verify per docs/SETUP.md.
# With two accounts to pick between, `!account off` / `!account on` switches
# the pin from chat without touching this line or restarting the worker.
#CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-xxxxxxxx

# ── Conversation memory ─────────────────────────────────────────────────────
# A DM (or a thread) keeps its Claude session, so follow-up messages continue
# instead of starting over. It resets after this many minutes of silence —
# longer means better continuity but a heavier context, and cost, every turn.
# 0 = never expire. `!new` resets one conversation on demand regardless.
SESSION_IDLE_MIN=120

# ── Nudges ──────────────────────────────────────────────────────────────────
# Loki speaks first when something trips: a goal you have not touched in days,
# three runs failing the same way, the selected provider unable to answer. Each
# alert arrives with buttons — run it, park it, or silence that one watcher.
# `!nudge off` turns the whole thing off from chat without editing this file.
#LOKI_NUDGE=on                # on | off — start with unprompted alerts armed
#LOKI_NUDGE_POLL_MIN=15       # how often the watchers look
#LOKI_NUDGE_STALE_H=72        # hours of no movement before a goal is "stale"

# ── Optional ────────────────────────────────────────────────────────────────
#CLAUDE_MODEL=sonnet          # lighter on your subscription limits (default: account default)
#TIMEOUT_SEC=300              # per-request timeout (seconds)
#JOB_CONCURRENCY=2            # parallel Claude jobs (same conversation stays ordered)
#LOKI_LANG=en                 # bot message language: en | ko
#LOKI_CHANNEL_CTX_DAYS=7      # channel history window for bare channel mentions
#LOKI_CHANNEL_CTX_MSGS=120    # max messages in that window
#CLAUDE_CMD=                  # auto-detected from PATH; set the full path if needed
#SELFTEST_ON_BOOT=1           # verify read-only guarantee at boot (plan mode only)

# ── Private commands (optional) ──────────────────────────────────────────────
# If you copy private_commands.example.py → private_commands.py (gitignored),
# set the trusted-user allowlist(s) it reads here, e.g.:
#REPORT_USERS=U01234567,U07654321   # named users allowed to run your !command

# Per-file cap for attachments in and !send out (MB).
#LOKI_MAX_FILE_MB=20
